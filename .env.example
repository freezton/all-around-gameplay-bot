# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: restrict the archive to one user. Leave empty/commented to archive everyone.
# TARGET_USER_ID=

# Optional: limit collection to a single server. Right-click the server -> Copy Server ID.
# TARGET_GUILD_ID=

# Optional: sync slash commands to this guild instantly while developing.
# DEV_GUILD_ID=

# Where the SQLite archive lives (defaults to data/bot.db).
# DATABASE_PATH=data/bot.db

LOG_LEVEL=INFO
